# Copie para .env.local (desenvolvimento) e configure as mesmas
# variáveis no painel da Vercel (produção).

# Postgres (Neon). Deixe em branco em desenvolvimento para usar o banco
# local automático (PGlite, sem precisar instalar nada).
DATABASE_URL=

# Sessão de login — gere uma string aleatória longa, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Login do cliente (dia a dia). Em produção prefira ADMIN_PASSWORD_HASH
# (veja DEPLOY.md) em vez de senha em texto puro.
ADMIN_EMAIL=voce@example.com
ADMIN_PASSWORD=troque-esta-senha
# ADMIN_PASSWORD_HASH=

# Login extra opcional para quem dá suporte (você) — mesmo acesso do login
# acima, mas com e-mail/senha próprios, para não precisar saber a senha do
# cliente. Deixe em branco (não defina SUPPORT_EMAIL) se não quiser usar.
# SUPPORT_EMAIL=suporte@suaempresa.com
# SUPPORT_PASSWORD_HASH=

# URL pública do site, usada para montar o link do orçamento
# (ex.: https://marmoraria.vercel.app). Em dev pode deixar em branco.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
